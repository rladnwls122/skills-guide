.obsidian/
node_modules/

# 개인 설정 — .claude/settings.json 은 공유하고 이것만 제외한다
.claude/settings.local.json
.superpowers/

dist/
.astro/
.vercel/

# 저장소 자격 증명 — 절대 커밋하지 않는다. 예시는 .env.example 에 둔다
.env
.env.*
!.env.example

scripts/.font-cache/

# 브라우저 확인 산출물 — 스크린샷과 playwright 스냅샷은 커밋하지 않는다
.playwright-mcp/
/*.png
/*.jpeg

# git worktree — 커밋하지 않는다
.claude/worktrees/

# 서버 배포 스크립트
deploy.sh

# 옵시디언이 루트에 만드는 잔여물 — 사이트 콘텐츠는 src/content/docs/ 아래다
/*.base
/*.canvas
/reference/
/start/
.vercel
.env*
# 값이 빈 예시만 커밋한다. 위 .env* 뒤에 와야 부정이 이긴다
!.env.example
